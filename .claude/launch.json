{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/site/serve.mjs", "--dir", "dist/apps/site", "--port", "4600"],
      "port": 4600
    },
    {
      "name": "site-subpath",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/site/serve.mjs", "--dir", "dist/apps/site", "--port", "4601", "--prefix", "/braid-site/"],
      "port": 4601
    },
    {
      "name": "prod-remote",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "serve-dist",
        "prod-remote"
      ],
      "port": 4411
    },
    {
      "name": "prod-host",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "serve-dist",
        "prod-host"
      ],
      "port": 4410
    },
    {
      "name": "console-demo-mock-okta",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BRAID_DEMO_AUTH=mock",
        "TSX_TSCONFIG_PATH=tsconfig.base.json",
        "npx",
        "tsx",
        "tools/braid-console/demo-server.mjs"
      ],
      "port": 9100
    },
    {
      "name": "console-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TSX_TSCONFIG_PATH=tsconfig.base.json",
        "npx",
        "tsx",
        "tools/braid-console/demo-server.mjs"
      ],
      "port": 9100
    }
  ]
}

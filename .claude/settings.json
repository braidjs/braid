{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(npm run:*)","Bash(npm test:*)","Bash(npm ci:*)","Bash(npm install:*)",
      "Bash(npx:*)","Bash(pnpm:*)","Bash(yarn:*)","Bash(node:*)","Bash(tsc:*)",
      "Bash(ng:*)","Bash(nx:*)","Bash(vitest:*)","Bash(jest:*)","Bash(karma:*)",
      "Bash(eslint:*)","Bash(prettier:*)","Bash(make:*)",
      "Bash(git status:*)","Bash(git diff:*)","Bash(git log:*)","Bash(git show:*)",
      "Bash(git branch:*)","Bash(git checkout:*)","Bash(git switch:*)","Bash(git add:*)",
      "Bash(git commit:*)","Bash(git stash:*)","Bash(git fetch:*)","Bash(git pull:*)",
      "Bash(git push:*)","Bash(gh pr create:*)","Bash(gh pr view:*)","Bash(gh pr list:*)",
      "Agent(planner)","Agent(simplifier)","Agent(goal-verifier)","Agent(shipper)",
      "Agent(code-reviewer)","Agent(test-engineer)","Agent(security-auditor)",
      "Agent(web-performance-auditor)"
    ],
    "deny": [
      "Bash(rm -rf:*)","Bash(npm publish:*)","Bash(git reset --hard:*)",
      "Read(./.env)","Read(./.env.*)","Read(~/.ssh/**)","Read(~/.aws/credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [{"matcher":"Bash","hooks":[{"type":"command","command":"\"$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.sh\"","timeout":15}]}],
    "Stop": [{"matcher":"","hooks":[{"type":"command","command":"\"$CLAUDE_PROJECT_DIR/.claude/hooks/goal-gate.sh\"","timeout":360}]}],
    "SessionStart": [{"matcher":"","hooks":[{"type":"command","command":"rm -f \"$CLAUDE_PROJECT_DIR/.claude/.goal-turns\""}]}]
  }
}

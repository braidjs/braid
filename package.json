  "scripts": {
    "lint": "nx run-many -t lint",
    "lint:libs": "nx run-many -t lint -p skew build-tools angular-router angular-data angular-workflow",
    "lint:fix": "nx run-many -t lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "test:libs": "nx run-many -t test -p skew build-tools angular-router angular-data angular-workflow",
    "test:angular-core": "nx test angular-core",
    "test:build-tools": "nx test build-tools",
    "test:angular-router": "nx test angular-router",
    "test:angular-data": "nx test angular-data",
    "test:angular-workflow": "nx test angular-workflow",
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build -p skew build-tools angular-router angular-data angular-workflow",
    "build:angular-core": "nx build angular-core",
    "build:build-tools": "nx build build-tools",
    "build:angular-router": "nx build angular-router",
    "build:angular-data": "nx build angular-data",
    "build:angular-workflow": "nx build angular-workflow",
    "verify": "npm run lint:libs && npm run test:libs && npm run build:libs",
    "release:version": "nx release version",
    "release:changelog": "nx release changelog",
    "deploy:libs:dry-run": "nx release publish --dry-run",
    "deploy:libs": "nx release publish",
    "registry": "nx local-registry",
    "deploy:libs:local": "nx release publish --registry=http://localhost:4873",
    "start": "nx serve shell",
    "demo": "nx serve shell",
    "demo:build": "nx build shell",
    "demo:serve-static": "nx serve-static shell",
    "demo:prod": "npm run demo:prod:build && npm run demo:prod:serve",
    "demo:prod:build": "npm run demo:prod:deploy-remote && npm run demo:prod:deploy-host",
    "demo:prod:deploy-host": "node tools/deploy-demo.mjs host",
    "demo:prod:deploy-remote": "node tools/deploy-demo.mjs remote",
    "demo:prod:redeploy-remote": "node tools/deploy-demo.mjs remote",
    "demo:prod:serve": "nx run-many -t serve-dist -p prod-host prod-remote --parallel=2",
    "demo:prod:serve-host": "nx serve-dist prod-host",
    "demo:prod:serve-remote": "nx serve-dist prod-remote",
    "demo:prod:dev": "nx run-many -t serve -p prod-host prod-remote --parallel=2",
    "demo:prod:same-origin": "npm run demo:prod:build && npm run demo:prod:serve-same-origin",
    "demo:prod:serve-same-origin": "node tools/serve-same-origin.mjs",
    "api": "nx serve api",
    "api:build": "nx build api",
    "braid:demo": "node tools/braid-poc/run.mjs",
    "braid:demo:build": "nx run-many -t build -p braid-poc-remote braid-poc-react-remote braid-poc-widget braid-poc-contract braid-poc-host && nx build-app braid-console",
    "braid:dev": "node libs/braid-cli/src/bin.js dev",
    "braid:serve-host": "nx serve braid-poc-host",
    "braid:serve-remote": "nx serve braid-poc-remote",
    "braid:serve-react-remote": "node tools/braid-poc/serve-static.mjs dist/apps/braid-poc-react-remote 4502 --spa",
    "braid:serve-widget": "node tools/braid-poc/serve-static.mjs dist/apps/braid-poc-widget 4503",
    "braid:serve-contract": "node tools/braid-poc/serve-static.mjs dist/apps/braid-poc-contract 4506 --cors",
    "demo:braid": "node tools/braid-poc/run.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:skew": "nx test skew",
    "build:skew": "nx build skew"
  },
  "private": true,

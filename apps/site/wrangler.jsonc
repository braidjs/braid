// Cloudflare Worker for the public site: static assets for every page, plus POST /api/contact.
//
// Before the first deploy, replace the three example.com addresses below with real ones:
//   - EMAIL.destination_address and CONTACT_TO: the inbox that receives enquiries. It must be a
//     verified destination address in Cloudflare Email Routing.
//   - CONTACT_FROM: a sender on the domain you route through Cloudflare, e.g. site@yourdomain.
// and set the Turnstile secret once:  npx wrangler secret put TURNSTILE_SECRET --config apps/site/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "braid-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../dist/apps/site",
    "binding": "ASSETS",
    // Code runs for the form endpoint only; pages, scripts and fragments are served as plain files.
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "EMAIL", "destination_address": "enquiries@example.com" }],
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "CONTACT_TO": "enquiries@example.com",
    "CONTACT_FROM": "site@example.com"
  },
  "observability": { "enabled": true }
}

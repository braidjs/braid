{
  "id": "screen-home",
  "slug": "home",
  "title": "Home",
  "root": {
    "id": "n_root",
    "type": "stack",
    "v": 1,
    "props": {
      "gap": "md"
    },
    "slots": {
      "children": [
        {
          "id": "n_hero",
          "type": "hero-banner",
          "v": 3,
          "props": {
            "title": "Summer sale",
            "subtitle": "Up to 40% off outdoor",
            "cta": {
              "label": "Shop the sale"
            },
            "countdown": {
              "endsAt": "2026-11-20T00:00:00Z"
            }
          },
          "actions": {
            "press": {
              "type": "navigate",
              "v": 2,
              "props": {
                "to": "sale",
                "transition": "modal"
              }
            }
          },
          "analytics": {
            "name": "home_hero"
          }
        },
        {
          "id": "n_card_runner",
          "type": "product-card",
          "v": 3,
          "props": {
            "title": "Trail Runner 2",
            "price": {
              "amount": 129,
              "sale": 99
            },
            "badge": "New"
          },
          "actions": {
            "press": {
              "type": "navigate",
              "v": 2,
              "props": {
                "to": "product/trail-runner-2",
                "transition": "push"
              }
            }
          },
          "fallback": {
            "id": "n_card_runner_fallback",
            "type": "text",
            "v": 2,
            "props": {
              "content": "Trail Runner 2, now $99",
              "style": "body"
            }
          }
        },
        {
          "id": "n_card_shell",
          "type": "product-card",
          "v": 3,
          "props": {
            "title": "Ridge Shell",
            "price": {
              "amount": 168,
              "sale": null
            },
            "badge": null
          }
        },
        {
          "id": "n_video",
          "type": "video-tile",
          "v": 1,
          "props": {
            "title": "How we test our boots",
            "seconds": 42,
            "src": "asset_boots_test"
          },
          "fallback": {
            "id": "n_video_fallback",
            "type": "text",
            "v": 2,
            "props": {
              "content": "How we test our boots",
              "style": "link"
            },
            "actions": {
              "press": {
                "type": "open-url",
                "v": 1,
                "props": {
                  "url": "https://acme.example/boots"
                }
              }
            }
          }
        },
        {
          "id": "n_share",
          "type": "text",
          "v": 2,
          "props": {
            "content": "Share this sale",
            "style": "link"
          },
          "actions": {
            "press": {
              "type": "share",
              "v": 1,
              "props": {
                "text": "Summer sale at Acme"
              }
            }
          }
        },
        {
          "id": "n_promo",
          "type": "text",
          "v": 2,
          "props": {
            "content": "Members get free shipping",
            "style": "body"
          },
          "visibility": {
            "all": [
              {
                "flag": "member-promo"
              },
              {
                "audience": "members"
              }
            ]
          }
        },
        {
          "id": "n_legal",
          "type": "legal-note",
          "v": 2,
          "props": {
            "text": "Prices include tax."
          }
        },
        {
          "id": "n_returns",
          "type": "legal-note",
          "v": 2,
          "props": {
            "text": "Free returns within 30 days."
          },
          "fallback": {
            "id": "n_returns_fallback",
            "type": "text",
            "v": 2,
            "props": {
              "content": "Free returns within 30 days.",
              "style": "body"
            }
          }
        }
      ]
    }
  },
  "states": {
    "loading": "auto",
    "empty": {
      "id": "n_empty",
      "type": "text",
      "v": 2,
      "props": {
        "content": "Nothing picked for you yet",
        "style": "body"
      }
    },
    "error": "system",
    "offline": "system"
  }
}

    "Fare": {
      "contract": {
        "skewContract": "1",
        "name": "sdui.component.Fare",
        "current": 3,
        "steps": [
          {
            "from": 1,
            "to": 2,
            "description": "the amount becomes an object that carries its currency",
            "ops": [
              {
                "wrap": {
                  "path": "amount",
                  "key": "value",
                  "also": {
                    "currency": "USD"
                  }
                }
              }
            ]
          },
          {
            "from": 2,
            "to": 3,
            "description": "an optional badge",
            "ops": [
              {
                "default": {
                  "path": "badge",
                  "value": null
                }
              }
            ]
          }
        ],
        "schemas": {
          "1": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              }
            },
            "required": ["label", "amount"]
          },
          "2": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "type": "object",
                "properties": {
                  "value": {},
                  "currency": {}
                }
              }
            },
            "required": ["label", "amount"]
          },
          "3": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "type": "object",
                "properties": {
                  "value": {},
                  "currency": {}
                }
              },
              "badge": {}
            },
            "required": ["label", "amount"]
          }
        }
      },
      "criticalPaths": ["amount.currency"],
      "fallback": {
        "type": "Text",
        "props": {
          "text": {
            "$from": "label"
          }
        }
      },
      "editor": {
        "label": "Fare",
        "group": "Travel"
      }
    },
    "Rating": {
      "contract": {
        "skewContract": "1",
        "name": "sdui.component.Rating",
        "current": 2,
        "steps": [
          {
            "from": 1,
            "to": 2,
            "description": "stars become a number",
            "ops": [
              {
                "convert": {
                  "path": "stars",
                  "to": "number"
                }
              }
            ]
          }
        ],
        "schemas": {
          "1": {
            "type": "object",
            "properties": {
              "stars": {
                "type": "string"
              }
            },
            "required": ["stars"]
          },
          "2": {
            "type": "object",
            "properties": {
              "stars": {}
            },
            "required": ["stars"]
          }
        }
      },
      "fallback": "omit"
    },
    "FlightCard": {
      "contract": {
        "skewContract": "1",
        "name": "sdui.component.FlightCard",
        "current": 1,
        "steps": [],
        "schemas": {
          "1": {
            "type": "object",
            "properties": {
              "flight": {},
              "status": {},
              "gate": {}
            },
            "required": ["flight"]
          }
        }
      },
      "a2ui": {
        "actions": ["select"]
      },
      "fallback": {
        "type": "Text",
        "props": {
          "text": {
            "$from": "flight"
          }
        }
      }
    }

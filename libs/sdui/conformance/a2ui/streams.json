{
  "description": "A2UI v1.0 streams this package refuses, each with the error the last message gets, and streams it accepts that look as if they might be refused. Messages are applied in order: parse, then apply to the surfaces, then convert the surface to the SDUI model.",
  "refused": [
    {
      "name": "an update before its surface exists",
      "messages": [
        {
          "version": "1.0",
          "updateComponents": {
            "surfaceId": "s",
            "components": [
              {
                "id": "root",
                "component": "Text",
                "text": "hi"
              }
            ]
          }
        }
      ],
      "error": {
        "code": "INTEGRITY_ERROR",
        "path": "/surfaceId"
      }
    },
    {
      "name": "a data model update before its surface exists",
      "messages": [
        {
          "version": "1.0",
          "updateDataModel": {
            "surfaceId": "s",
            "value": {}
          }
        }
      ],
      "error": {
        "code": "INTEGRITY_ERROR",
        "path": "/surfaceId"
      }
    },
    {
      "name": "deleting a surface that does not exist",
      "messages": [
        {
          "version": "1.0",
          "deleteSurface": {
            "surfaceId": "s"
          }
        }
      ],
      "error": {
        "code": "INTEGRITY_ERROR",
        "path": "/surfaceId"
      }
    },
    {
      "name": "creating a surface twice",
      "messages": [
        {
          "version": "1.0",
          "createSurface": {
            "surfaceId": "s",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
          }
        },
        {
          "version": "1.0",
          "createSurface": {
            "surfaceId": "s",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
          }
        }
      ],
      "error": {
        "code": "INTEGRITY_ERROR",
        "path": "/surfaceId"
      }
    },
    {
      "name": "an unknown @ key on a component",
      "messages": [
        {
          "version": "1.0",

{
  "name": "@braidlabs/registry",
  "version": "0.0.1",
  "description": "Immutable, content-addressed snapshots of a Braid fragment registry, with validation and diff analysis.",
  "keywords": ["braid", "micro-frontends", "registry", "configuration", "snapshots"],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./node": { "types": "./src/node.d.ts", "default": "./src/node.js" },
    "./oidc": { "types": "./src/oidc.d.ts", "default": "./src/oidc.js" },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@braidlabs/gateway": "^0.0.1",
    "jose": "^6.2.12"
  },
  "peerDependenciesMeta": {
    "jose": { "optional": true }
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braidjs/braid.git",
    "directory": "libs/braid-registry"
  },
  "homepage": "https://github.com/braidjs/braid#readme",
  "bugs": { "url": "https://github.com/braidjs/braid/issues" }
}

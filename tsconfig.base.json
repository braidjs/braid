{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@braidlabs/angular-data": ["./libs/angular/data/src/index.ts"],
      "@braidlabs/angular-router": ["./libs/angular/router/src/index.ts"],
      "@braidlabs/angular-workflow": ["./libs/angular/workflow/src/index.ts"],
      "@braidlabs/core": ["./libs/core/src/index.ts"],
      "@braidlabs/angular": ["./libs/braid-angular/src/index.ts"],
      "@braidlabs/cli": ["./libs/braid-cli/src/index.ts"],
      "@braidlabs/console": ["./libs/braid-console/src/index.ts"],
      "@braidlabs/react": ["./libs/braid-react/src/index.ts"],
      "@braidlabs/registry": ["./libs/braid-registry/src/index.ts"],
      "@braidlabs/registry/node": ["./libs/braid-registry/src/node.ts"],
      "@braidlabs/registry/oidc": ["./libs/braid-registry/src/oidc.ts"],
      "@braidlabs/sw": ["./libs/braid-sw/src/index.ts"],
      "@braidlabs/fdc3": ["./libs/braid-fdc3/src/index.ts"],
      "@braidlabs/gateway": ["./libs/braid-gateway/src/index.ts"],
      "@braidlabs/gateway/node": ["./libs/braid-gateway/src/node.ts"],
      "@braidlabs/build": ["./libs/build/src/index.ts"],
      "@braidlabs/contract": ["./libs/contract/src/index.ts"],
      "@braidlabs/skew": ["./libs/skew/src/index.ts"],
      "@braidlabs/data": ["./libs/data/src/index.ts"],
      "@braidlabs/studio": ["./libs/studio/src/index.ts"],
      "@braidlabs/angular-core": ["./libs/angular/core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
